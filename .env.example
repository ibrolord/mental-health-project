# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# AI Models
# Stable provider used for standard conversations. Switch to gemini only after
# `npm run verify:ai-live` passes with a valid Google credential.
AI_PRIMARY_PROVIDER=claude

# Google Gemini (optional fallback)
GOOGLE_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-3.5-flash
# Optional overrides for generated voice playback.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (for voice therapy mode)
OPENAI_API_KEY=your_openai_api_key

# Server-only HMAC secret for binding in-app AI reports to generated responses
AI_REPORT_SIGNING_SECRET=generate_at_least_32_random_characters

# Opt-in Web Push reminders
# Generate a VAPID pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@example.com
# Set true only after an external scheduler calls the dispatch route every 5 minutes.
NEXT_PUBLIC_REMINDER_DISPATCH_ENABLED=false
# The scheduler must send this as Authorization: Bearer <secret>.
CRON_SECRET=generate_at_least_32_random_characters
