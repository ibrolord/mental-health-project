# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# AI Models
# Google Gemini (Free tier - used for most conversations)
GOOGLE_API_KEY=your_google_ai_api_key
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude (Paid - used for complex/crisis situations only)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (for voice therapy mode)
OPENAI_API_KEY=your_openai_api_key

# Server-only HMAC secret for binding in-app AI reports to generated responses
AI_REPORT_SIGNING_SECRET=generate_at_least_32_random_characters
